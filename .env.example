# Service
# Bind address and port for the in-lab API (/api/health, /api/status, /api/cycle).
APP_HOST=127.0.0.1
APP_PORT=8000
# Python logging level name.
LOG_LEVEL=INFO

# Cycle
# Seconds between cycles. 900 = the 15-minute cadence the site expects.
INTERVAL_SECONDS=900
# Days of daily uptime history per node (VictoriaMetrics keeps 90).
UPTIME_DAYS=90
# Per-request timeout for every source, in seconds.
SOURCE_TIMEOUT_SECONDS=10

# Topology
# The JSON homelab-inventory renders (tools/render_halifirien_topology.py). In the ring it
# is a ConfigMap mounted at this path.
TOPOLOGY_PATH=./out/topology.json

# Sources (read-only; in the ring these are in-cluster Service URLs)
# Gatus base URL; halifirien reads /api/v1/endpoints/statuses.
GATUS_URL=http://localhost:8080
# Prometheus-compatible query API (VictoriaMetrics vmsingle).
METRICS_URL=http://localhost:8428
# Alertmanager base URL; halifirien reads /api/v2/alerts.
ALERTMANAGER_URL=http://localhost:9093

# Publishing (off by default: build, gate and serve in-lab, send nothing)
# true sends each gated document to S3.
PUBLISH_ENABLED=false
# The website's bucket. Required when PUBLISH_ENABLED=true.
S3_BUCKET=
# Object key the website reads.
S3_KEY=status/status.json
# Cache-Control on the object; CloudFront and browsers honour it.
S3_CACHE_CONTROL=public, max-age=60
# AWS credentials come from the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars,
# injected from 1Password in the ring. Never put them in this file.
AWS_REGION=us-east-1
